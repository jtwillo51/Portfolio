{
  "name": "jeremywilloughby",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Portfolio of Jeremy Willoughby \u2014 Vue 3, TypeScript, prerendered to static HTML.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && node prerender.mjs",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist-ssr",
    "preview": "vite preview --outDir dist",
    "serve": "node scripts/serve.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:preview": "vite build --mode preview && node scripts/bundle-preview.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
